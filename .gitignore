# Expo
.expo/
dist/
web-build/

# Node
node_modules/
npm-debug.log*

# Native builds (prebuild-output in de projectroot).
# Let op de leidende slash: zonder anker matcht "ios/" ELKE map met die naam,
# ook modules/*/ios van lokale Expo-modules — die horen juist wél in git.
/ios/
/android/
*.ipa
*.apk
*.aab

# EAS
.easignore

# Omgeving en secrets
.env
.env.*
!.env.example
google-service-account.json
# eas.json bevat mogelijk omgevingsvariabelen; gebruik EAS Secrets voor sleutels
eas.json

# iOS-ondertekening (nooit in git)
*.p12
*.p8
*.mobileprovision
*.cer
*.certSigningRequest
ios-cert/
credentials.json

# macOS / Windows
.DS_Store
Thumbs.db

# Sync-artefacten
.fuse_hidden*

# Supabase CLI (lokale artefacten, horen niet in git)
supabase/.temp/

# Website-exports en zip-artefacten (horen niet in de app-repo)
*.zip
assets/Lopen te Lopen - live.html

# Store-screenshots (marketing-assets, leven in App Store Connect; feature-graphic
# blijft wel getrackt als centrale bron)
store-assets/Screenshots IOS/

# Losse projecten en interne documenten (geen app-broncode, horen niet op GitHub):
# handover-notities, commerciele strategie, security/design reviews, de losse
# website- en marketing-projecten, en losse dev-tools zoals elevenlabs-mcp.
_workspace/
.agents/
